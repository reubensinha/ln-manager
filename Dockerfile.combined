# Dockerfile.combined
# 1) Build the frontend. The runtime rebuilds it too (user plugins mount into
#    src/plugins and Vite's manifest glob is build-time), but this stage is what
#    produces the audited node_modules and the fallback bundle. Deliberately a Debian
#    (glibc) image, not alpine: node_modules is copied into the python:3.12-slim app
#    stage, and musl-linked native binaries (rollup, esbuild) would not run there.
FROM node:24-slim AS frontend-build
WORKDIR /frontend

# Install from the committed lockfile so the image gets exactly the versions that
# were locked and audited - not whatever the semver ranges resolve to today.
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile && yarn cache clean

COPY frontend/ .
ARG VERSION
ARG BASE_PATH=""
# No "|| true" here: a frontend that doesn't compile should fail the build rather
# than silently ship an image with no bundle.
RUN env PUBLIC_VERSION=${VERSION:-} PUBLIC_API_URL=${BASE_PATH:-} BASE_PATH=${BASE_PATH:-} yarn build

# 2) App image
FROM python:3.12-slim AS app
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Default port for the application; can be overridden at runtime with -e PORT=
ENV PORT=9583

# Install system packages needed (curl for healthcheck, build-essential if needed)
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg build-essential \
  && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy backend source
COPY backend/ /app/backend

# Copy frontend source into image so we can build at container startup. This allows
# newly installed plugins (which may add assets) to be included when the frontend
# is built on launch.
COPY frontend/ /app/frontend

# Ship the prebuilt bundle to where the app actually serves from
# (core/constants.py sets STATIC_DIR = frontend/dist), plus a pristine copy the
# entrypoint can fall back to when a startup rebuild fails.
COPY --from=frontend-build /frontend/dist /app/frontend/dist
COPY --from=frontend-build /frontend/dist /app/frontend/dist.baked

# Reuse the dependency tree installed from the lockfile above, so the startup
# rebuild needs no registry access and cannot drift between boots.
COPY --from=frontend-build /frontend/node_modules /app/frontend/node_modules

# The frontend plugin volume mounts here; create it so the manifest glob always
# has a directory to look at even when nothing is mounted.
RUN mkdir -p /app/frontend/src/plugins

# Install Node.js runtime in the final image so the entrypoint can rebuild the
# frontend when plugin components are mounted in.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Healthcheck (adjust if needed)
HEALTHCHECK --interval=30m --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT}/api/health || exit 1

EXPOSE ${PORT}

# Copy entrypoint that will build frontend at container start and then launch uvicorn
COPY docker/entrypoint.sh /app/docker/entrypoint.sh
RUN chmod +x /app/docker/entrypoint.sh

# Run from /app so backend package is importable
WORKDIR /app
ENV PYTHONPATH=/app
# Set plugin data directory for persistent plugin data (within config/)
ENV PLUGIN_DATA_DIR=/app/backend/config/plugin-data
ENTRYPOINT ["/app/docker/entrypoint.sh"]
